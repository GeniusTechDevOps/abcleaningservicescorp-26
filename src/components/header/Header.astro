---
import Menu from "../headerComponents/Menu.tsx";
import type { RootObject } from "../../interfaces/dbData.ts";
import ToggleButton from "../global/ToggleButton";
import MenuMobile from "../headerComponents/MenuMobile.tsx";

let API_URL = import.meta.env.API_URL;
// Realiza la llamada a la API
const response = await fetch(`${API_URL}`);
const data: RootObject = await response.json();
---

<header transition:animate="none" class="relative md:absolute w-full z-50 top-0 left-0">
  <section
    class="w-full h-auto flex flex-col md:flex-row justify-center items-center gap-4"
  >
    <div class="w-1/3 hidden  md:flex justify-start items-center px-2">
      <img 
      src={data.logos.primary} alt={`logo ${data?.name}`} loading="eager" class="w-4/5 h-auto  " />
    </div>
    <div class="w-3/5 h-auto hidden  md:flex justify-center items-center ">
      {
        data.widgets.onePages
          ? null
          : <Menu data={data} colorText="text-white" />
      }
    </div>
    <div class="w-1/4 hidden  md:flex justify-end items-center p-2">
      <ToggleButton client:load data={data} />
    </div>
    <div class="w-full md:hidden flex justify-center items-center">
      <MenuMobile data={data} client:load />
    </div>

  </section>
</header>
