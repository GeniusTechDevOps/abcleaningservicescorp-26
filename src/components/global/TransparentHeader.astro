---
import type { RootObject } from "../../interfaces/dbData";


interface Props {
  image: string;
  title?: string;
}

const { image, title } = Astro.props;

const response = await fetch(import.meta.env.API_URL);
---

<div
  class="flex flex-col md:flex-row w-full relative md:px-0 overflow-hidden h-auto md:h-[90vh]"
>
  <div class="w-full h-auto relative">
    <div class="w-1/4 h-full bg-primary md:bg-white z-10 absolute left-0 top-0">
      <div
        class="bg-[url(/assets/img/dots.png)] w-full h-full bg-cover opacity-30 bg-bottom"
      >
      </div>
    </div>
    <div
      class="w-[94%] md:w-[86%] h-full pt-[20px] md:pt-[140px] ml-auto relative z-10  bg-primary pb-10 pl-0 md:pl-10"
    >
      <div
        class="w-full h-auto md:h-full relative flex justify-start items-center py-12 md:py-0"
      >
        <img
          src={image}
          alt="img"
          class="w-full h-full absolute left-0 top-0 z-10 rounded-l-3xl object-cover"
        />
        <div
          class="w-full h-full absolute left-0 top-0 bg-gradient-to-r from-black/60 to-transparent z-10 rounded-l-3xl"
        >
        </div>
        <div
          class="w-full md:w-3/5 h-4/5 text-white py-10 md:py-0 pl-5 md:pl-10 pr-5 md:pr-28 relative z-10 flex flex-col justify-center items-start gap-y-5"
        >
          <h1 class="text-3xl md:text-5xl capitalize font-black">{title}</h1>
          <a
            href="/"
            class="flex items-center gap-2 text-white text-[16px] font-medium hover:text-white transition-all duration-300 ease-in-out"
          >
            <i class="fa-solid fa-home"></i>
            <span class="text-white text-[16px] font-medium">Home</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</div>
