---
import type { RootObject, SectionsHomeAbout } from "../../interfaces/dbData";

let API_URL = import.meta.env.API_URL;
// Realiza la llamada a la API
const response = await fetch(`${API_URL}`);
const data: RootObject = await response.json();
//filtrar para obtener la section de about

const year = new Date().getFullYear();
---

<footer class="text-white">
  <div class="w-full relative h-auto bg-white">
    
    <div
      class="w-11/12 h-auto p-5 flex flex-col items-center relative z-10 mx-auto"
    >
      <div class="w-full md:w-4/5 p-5 mx-auto">
        <img
          src={data.logos.secondary}
          class="w-full md:w-[35%] h-auto object-contain mx-auto"
          alt="logo"
        />
      </div>
      <div>
        {
          data.widgets.onePages ? null : (
            <ul class="list-none text-white gap-2 md:gap-8 font-light flex flex-row flex-wrap md:flex-row justify-center items-start mx-auto text-lg">
              <li
                class="mx-2 flex gap-2 items-center hover:transform
        hover:scale-110 transition-all duration-300 ease-in-out"
              >
                <a href="/" class="text-black">
                  Home
                </a>
              </li>
              <li
                class="mx-2 flex gap-2 items-center hover:transform
        hover:scale-110 transition-all duration-300 ease-in-out"
              >
                <a href="/about" class="text-black">
                  About
                </a>
              </li>
              <li
                class="mx-2 flex gap-2 items-center hover:transform
        hover:scale-110 transition-all duration-300 ease-in-out"
              >
                <a href="/portfolio" class="text-black">
                  Portfolio
                </a>
              </li>
              <li
                class="mx-2 flex gap-2 items-center hover:transform
        hover:scale-110 transition-all duration-300 ease-in-out"
              >
                <a href="/contact" class="text-black">
                  Contact
                </a>
              </li>
            </ul>
          )
        }
      </div>
    </div>
    <div
      class="w-4/5 h-auto flex flex-col md:flex-row items-center relative z-10 mx-auto border-secondary border-y-[0.5px]"
    >
      <div
        class="w-full md:w-1/3 flex flex-col justify-center py-3 items-center border-secondary border-0 md:border-r-[0.5px] p-2 text-white/80"
      >
        <div class="flex justify-center items-center gap-2">
          <i class="fa-light fa-phone text-lg text-secondary"></i>
          <div>
            {
              data.dataGeneral.phones.map((phone) => (
                <a
                  href={`tel:+1${phone.number}`}
                  class="flex flex-wrap text-secondary hover:underline px-2 py-1"
                >
                  <p
                    class=" hover:transform text-base font-bold
        hover:scale-110 transition-all duration-300 ease-in-out "
                  >
                    {phone.number}
                  </p>
                </a>
              ))
            }
          </div>
          
        </div>
      </div>
      <div
        class="w-full md:w-1/3 flex flex-col justify-center py-3 items-center border-secondary border-0 md:border-r-[0.5px] p-2 text-white/80"
      >
        {
          data.redesSociales.length > 0 && (
            <div class="flex justify-start gap-4">
              {data.redesSociales.map((item) => {
                return (
                  <a
                    href={item.link}
                    target="_blank"
                    aria-label={item.name}
                    class="w-10 h-10 flex justify-center items-center rounded-full bg-primary text-white"
                  >
                    <i class={`fa-brands fa-${item.icon}`} />
                  </a>
                );
              })}
            </div>
          )
        }
      </div>
      <div
        class="w-full md:w-1/3 flex flex-col justify-center py-3 items-center p-2 text-white/80"
      >
        <div class="flex justify-center items-center gap-2">
          <i class="fa-light fa-envelope text-lg text-secondary"></i>
          <div>
            {
              data.dataGeneral.emails.slice(0, 3).map((item) => (
                <a
                  href={`mailto:${item.email}`}
                  class="block text-secondary hover:underline px-2 py-2"
                >
                  <p
                    class=" hover:transform text-base font-bold
        hover:scale-110 transition-all duration-300 ease-in-out"
                  >
                    {item.email}
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
    <div
      class="md:w-[80%] mx-auto flex flex-wrap justify-center items-center pt-5"
    >
      <div>
        <p class="text-center text-black
      text-[16px] font-light">
          © {year} All rights reserved by {data.name}
        </p>
      </div>
    </div>
  </div>
</footer>
